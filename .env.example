SITE_NAME="Permaculture AI"
SITE_URL="http://localhost:8099"

# engine: forge (real GPU, ComfyUI on the forge box) | mock (tests / offline)
ENGINE=forge
FORGE_BASE_URL="http://forge:8188"
FORGE_TIMEOUT_S=300
# exactly one real GPU edit is allowed per run of the smoke test
FORGE_SMOKE=no

# limits
MAX_UPLOAD_MB=6
PER_IP_PER_DAY=1
GLOBAL_DAILY_CAP=25
QUEUE_MAX=6
ONE_JOB_AT_A_TIME=yes

# lead store
LEAD_STORE=./leads.csv

# filled in when Ryan publishes: the public API hostname, e.g. api.permacultureai.com
DEPLOY_HOST=
